# Copy to .env (gitignored) and fill in. The Makefile loads it for every target.

# GitHub PAT used by `make push` / `make pull`. Fine-grained, scoped to
# this repo only. Get one at https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Needed by `make demo` and `make serve` (real agents). Not needed for
# `make test` or `make demo-mock`. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5.
# ATC_MODEL=claude-sonnet-5-5

# Optional. Only if you go through a proxy instead of api.anthropic.com.
# ANTHROPIC_BASE_URL=http://localhost:4001
